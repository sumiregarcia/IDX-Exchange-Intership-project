    "# IQR outlier flagging\n",
    "# For each field, compute Q1/Q3/IQR, derive bounds, and add a flag column.\n",
    "# Records outside the bounds are marked True — they are NOT removed yet.\n",
    "\n",
    "def apply_iqr_flags(df, fields, label):\n",
    "    results = []\n",
    "    for field in fields:\n",
    "        if field not in df.columns:\n",
    "            continue\n",
    "        s      = pd.to_numeric(df[field], errors=\"coerce\").dropna()\n",
    "        Q1     = s.quantile(0.25)\n",
    "        Q3     = s.quantile(0.75)\n",
    "        IQR    = Q3 - Q1\n",
    "        lower  = Q1 - 1.5 * IQR\n",
    "        upper  = Q3 + 1.5 * IQR\n",
    "\n",
    "        flag_col = f\"flag_iqr_{field.lower()}\"\n",
    "        df[flag_col] = (\n",
    "            pd.to_numeric(df[field], errors=\"coerce\").lt(lower) |\n",
    "            pd.to_numeric(df[field], errors=\"coerce\").gt(upper)\n",
    "        )\n",
    "        n_flagged = df[flag_col].sum()\n",
    "\n",
    "        results.append({\n",
    "            \"Field\":       field,\n",
    "            \"Q1\":          round(Q1, 2),\n",
    "            \"Q3\":          round(Q3, 2),\n",
    "            \"IQR\":         round(IQR, 2),\n",
    "            \"Lower Bound\": round(lower, 2),\n",
    "            \"Upper Bound\": round(upper, 2),\n",
    "            \"Flagged\":     int(n_flagged),\n",
    "            \"Flagged %\":   f\"{n_flagged / len(df) * 100:.2f}%\",\n",
    "        })\n",
    "\n",
    "    summary = pd.DataFrame(results).set_index(\"Field\")\n",
    "    print(f\"{label} — IQR bounds and flagged counts:\")\n",
    "    display(summary)\n",
    "    return df, summary\n",
    "\n",
    "IQR_FIELDS_SOLD    = [\"ClosePrice\", \"LivingArea\", \"DaysOnMarket\", \"price_per_sqft\"]\n",
    "IQR_FIELDS_LISTING = [\"ListPrice\",  \"LivingArea\", \"DaysOnMarket\"]\n",
    "\n",
    "sold,    sold_iqr_summary    = apply_iqr_flags(sold,    IQR_FIELDS_SOLD,    \"Sold\")\n",
    "listing, listing_iqr_summary = apply_iqr_flags(listing, IQR_FIELDS_LISTING, \"Listing\")"
   ]
  },
