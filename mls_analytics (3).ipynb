    "# Build the Tableau-ready datasets\n",
    "# A record is excluded only if it is flagged as an outlier on ANY of the IQR fields.\n",
    "# The flagged files (with all flag columns) are also saved for reference.\n",
    "\n",
    "def build_tableau_ready(df, iqr_fields, label):\n",
    "    iqr_flag_cols = [f\"flag_iqr_{f.lower()}\" for f in iqr_fields if f\"flag_iqr_{f.lower()}\" in df.columns]\n",
    "\n",
    "    # Save full flagged version\n",
    "    df.to_csv(os.path.join(OUTPUT_PATH, f\"{label}_w7_flagged.csv\"), index=False)\n",
    "\n",
    "    # Build clean version: exclude any record flagged on any IQR field\n",
    "    any_iqr_flag = df[iqr_flag_cols].any(axis=1)\n",
    "    df_tableau   = df[~any_iqr_flag].copy()\n",
    "    df_tableau.to_csv(os.path.join(OUTPUT_PATH, f\"{label}_tableau_ready.csv\"), index=False)\n",
    "\n",
    "    return df_tableau\n",
    "\n",
    "sold_tableau    = build_tableau_ready(sold,    IQR_FIELDS_SOLD,    \"sold\")\n",
    "listing_tableau = build_tableau_ready(listing, IQR_FIELDS_LISTING, \"listing\")\n",
    "\n",
    "results = pd.DataFrame({\n",
    "    \"Before IQR filter\": [len(sold),          len(listing)],\n",
    "    \"After IQR filter\":  [len(sold_tableau),   len(listing_tableau)],\n",
    "    \"Removed\":           [len(sold)-len(sold_tableau), len(listing)-len(listing_tableau)],\n",
    "    \"Removed %\":         [\n",
    "        f\"{(len(sold)-len(sold_tableau))/len(sold)*100:.2f}%\",\n",
    "        f\"{(len(listing)-len(listing_tableau))/len(listing)*100:.2f}%\"\n",
    "    ],\n",
    "}, index=[\"Sold\",\"Listing\"])\n",
    "display(results)"
   ]
  },
