    "LISTING_PATH = r\"/Users/sumiregarcia/Desktop/INTERSHIP/IDX/CVS/LISTING\"\n",
    "\n",
    "OUTPUT_PATH = os.path.join(os.path.dirname(SOLD_PATH), \"output\")\n",
