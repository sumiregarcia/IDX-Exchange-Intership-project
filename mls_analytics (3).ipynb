    "# Side-by-side before/after histograms for ClosePrice and DaysOnMarket\n",
    "\n",
    "def before_after_chart(df, field, flag_col, title, color):\n",
    "    before = pd.to_numeric(df[field], errors=\"coerce\").dropna()\n",
    "    after  = before[~df.loc[before.index, flag_col]]\n",
    "\n",
    "    # Cap at 99th pct just for visualization\n",
    "    cap = before.quantile(0.99)\n",
    "    b   = before[before <= cap]\n",
    "    a   = after[after <= cap]\n",
    "\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(13, 4), sharey=False)\n",
    "    fig.suptitle(title, fontsize=13)\n",
    "\n",
    "    axes[0].hist(b, bins=60, color=color, edgecolor=\"white\", linewidth=0.3)\n",
    "    axes[0].set_title(f\"Before IQR filter  (n={len(b):,})\")\n",
    "    axes[0].set_xlabel(field)\n",
    "    axes[0].set_ylabel(\"Count\")\n",
    "\n",
    "    axes[1].hist(a, bins=60, color=color, edgecolor=\"white\", linewidth=0.3)\n",
    "    axes[1].set_title(f\"After IQR filter  (n={len(a):,})\")\n",
    "    axes[1].set_xlabel(field)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    print(f\"  Median before: {before.median():,.1f}  |  after: {after.median():,.1f}\")\n",
    "    print(f\"  Mean   before: {before.mean():,.1f}  |  after: {after.mean():,.1f}\")\n",
    "    print(f\"  Max    before: {before.max():,.1f}  |  after: {after.max():,.1f}\")\n",
    "\n",
    "before_after_chart(sold, \"ClosePrice\",   \"flag_iqr_closeprice\",\n",
    "                   \"Sold — ClosePrice: Before vs After IQR Filter\", \"#1f6aa5\")"
   ]
  },
