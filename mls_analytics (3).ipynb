    "# Summary statistics before vs after — confirms the filter cleaned up\n",
    "# the extreme values without shifting the median meaningfully\n",
    "\n",
    "comparison_fields = [f for f in [\"ClosePrice\",\"LivingArea\",\"DaysOnMarket\",\"price_per_sqft\"]\n",
    "                     if f in sold.columns and f in sold_tableau.columns]\n",
    "\n",
    "rows = []\n",
    "for field in comparison_fields:\n",
    "    before = pd.to_numeric(sold[field],         errors=\"coerce\").dropna()\n",
    "    after  = pd.to_numeric(sold_tableau[field],  errors=\"coerce\").dropna()\n",
    "    rows.append({\n",
    "        \"Field\":         field,\n",
    "        \"Median before\": round(before.median(), 1),\n",
    "        \"Median after\":  round(after.median(),  1),\n",
    "        \"Mean before\":   round(before.mean(),   1),\n",
    "        \"Mean after\":    round(after.mean(),     1),\n",
    "        \"Max before\":    round(before.max(),     1),\n",
    "        \"Max after\":     round(after.max(),      1),\n",
    "    })\n",
    "\n",
    "comparison = pd.DataFrame(rows).set_index(\"Field\")\n",
    "print(\"Sold — before vs after IQR filter:\")\n",
    "display(comparison)"
   ]
