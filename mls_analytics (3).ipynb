    "# Same comparison for Listing\n",
    "comparison_fields_l = [f for f in [\"ListPrice\",\"LivingArea\",\"DaysOnMarket\"]\n",
    "                       if f in listing.columns and f in listing_tableau.columns]\n",
    "rows = []\n",
    "for field in comparison_fields_l:\n",
    "    before = pd.to_numeric(listing[field],         errors=\"coerce\").dropna()\n",
    "    after  = pd.to_numeric(listing_tableau[field],  errors=\"coerce\").dropna()\n",
    "    rows.append({\n",
    "        \"Field\":         field,\n",
    "        \"Median before\": round(before.median(), 1),\n",
    "        \"Median after\":  round(after.median(),  1),\n",
    "        \"Mean before\":   round(before.mean(),   1),\n",
    "        \"Mean after\":    round(after.mean(),     1),\n",
    "        \"Max before\":    round(before.max(),     1),\n",
    "        \"Max after\":     round(after.max(),      1),\n",
    "    })\n",
    "comparison_l = pd.DataFrame(rows).set_index(\"Field\")\n",
    "print(\"Listing — before vs after IQR filter:\")\n",
    "display(comparison_l)\n",
    "\n",
    "print(\"Week 7 complete.\")\n",
    "print(f\"  sold_tableau_ready.csv    : {len(sold_tableau):,} rows x {sold_tableau.shape[1]} columns\")\n",
    "print(f\"  listing_tableau_ready.csv : {len(listing_tableau):,} rows x {listing_tableau.shape[1]} columns\")\n",
    "print(\"These are the final datasets to load into Tableau for Weeks 8-10.\")"
   ]
